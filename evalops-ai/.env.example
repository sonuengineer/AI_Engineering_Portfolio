# EvalOps AI -- example environment. Copy to .env and fill in. NEVER commit real secrets.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://evalops:evalops_dev_password@localhost:5443/evalops
POSTGRES_PASSWORD=evalops_dev_password

# Auth
JWT_SECRET=replace-with-a-random-string-of-at-least-32-bytes
JWT_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173

# Demo users created by scripts/seed.py (admin@evalops.local, member@..., viewer@...)
DEMO_USER_PASSWORD=change-me-demo-password

# LLM providers: local | gemini | openai  (local = deterministic adapter, no key needed)
LLM_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Black-box targets (credentials are read from env only, never stored in the DB)
NEXUS_BASE_URL=http://localhost:8101
NEXUS_EMAIL=
NEXUS_PASSWORD=
DATAWISE_BASE_URL=http://localhost:8102
DATAWISE_EMAIL=
DATAWISE_PASSWORD=

# Worker: run the job worker inside the API process (dev) or separately (python -m app.worker)
RUN_WORKER_IN_API=true
WORKER_POLL_SECONDS=1.0

# Limits
RATE_LIMIT_PER_MINUTE=240
LOGIN_RATE_LIMIT_PER_MINUTE=20
MAX_UPLOAD_BYTES=5242880

# Optional OpenTelemetry export (requires: uv sync --extra otlp)
OTEL_EXPORTER_OTLP_ENDPOINT=
LOG_LEVEL=INFO
