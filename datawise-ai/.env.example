# DATAWISE AI -- example environment. Copy to .env and change every value marked change-me.
# All values here are local-dev placeholders, NOT real secrets.

# --- Postgres server (docker compose service "db", host port 5442) ---
POSTGRES_USER=datawise
POSTGRES_PASSWORD=change-me-admin-password
# Password for the read-only analytics role (datawise_reader). Used by the docker init script.
DATAWISE_READER_PASSWORD=change-me-reader-password

# --- Backend connection strings (host-side dev; compose overrides host to "db") ---
APP_DATABASE_URL=postgresql+psycopg://datawise:change-me-admin-password@localhost:5442/datawise_app
# Admin connection to the analytics DB -- used ONLY by scripts/seed_analytics.py and evaluation/build_expected.py
ANALYTICS_ADMIN_DATABASE_URL=postgresql://datawise:change-me-admin-password@localhost:5442/datawise_analytics
# Read-only connection used by the API executor for every user question
ANALYTICS_READER_DATABASE_URL=postgresql://datawise_reader:change-me-reader-password@localhost:5442/datawise_analytics

# --- Auth ---
JWT_SECRET=change-me-dev-only-jwt-secret-at-least-32-characters
JWT_EXPIRES_MINUTES=60
# Password given to the seeded demo users (demo@acme.example, demo@globex.example)
DEMO_USER_PASSWORD=change-me-demo-password

# --- Planner provider: local | gemini | openai ---
LLM_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Query safety ---
MAX_ROWS=1000
STATEMENT_TIMEOUT_MS=5000
# Relative time phrases ("last month") are anchored to this date (end of the synthetic data range)
ANALYTICS_AS_OF_DATE=2026-10-31

# --- HTTP ---
CORS_ORIGINS=http://localhost:5172
RATE_LIMIT_ASK_PER_MINUTE=30
LOG_LEVEL=INFO
