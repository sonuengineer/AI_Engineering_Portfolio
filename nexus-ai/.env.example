# NEXUS AI -- copy to .env and fill in. Placeholders only; never commit real values.
APP_ENV=development
DATABASE_URL=postgresql+psycopg://nexus:nexus_local_only@localhost:5441/nexus
TEST_DATABASE_URL=postgresql+psycopg://nexus:nexus_local_only@localhost:5441/nexus_test
JWT_SECRET=change-me-to-a-long-random-string
ACCESS_TOKEN_MINUTES=60
DEMO_USER_PASSWORD=change-me-demo-password
CORS_ORIGINS=http://localhost:5171

# LLM provider: local (deterministic, no key) | gemini | openai
LLM_PROVIDER=local
GEMINI_API_KEY=
GEMINI_MODEL_FAST=gemini-2.5-flash
GEMINI_MODEL_STRONG=gemini-2.5-pro
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_STRONG=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Embeddings: local (hashing, lexical) | gemini | openai. Dimension is fixed by migration.
EMBEDDING_PROVIDER=local

# Budgets / limits
WORKFLOW_TOKEN_BUDGET=60000
MAX_UPLOAD_MB=15
URL_INGEST_ALLOWLIST=example.com,en.wikipedia.org
RATE_LIMIT_PER_MINUTE=60
